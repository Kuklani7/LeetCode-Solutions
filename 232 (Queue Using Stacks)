class MyQueue {

    private Stack<Integer> main= new Stack<>();
    private Stack<Integer> helper= new Stack<>();

    public MyQueue() {
        
    }
    
    public void push(int x) {
        while(!main.isEmpty()){
            helper.push(main.pop());
        }
        main.push(x);
        while(!helper.isEmpty()){
            main.push(helper.pop());
        }
    }
    
    public int pop() {
        int hmm=main.pop();
        return hmm;
    }
    
    public int peek() {
        int hmm= main.peek();
        return hmm;
    }
    
    public boolean empty() {
        return main.isEmpty();
    }
}
