class Solution {
    public int secondHighest(String s) {
        int first_number=-1;
        boolean first_number_derived=false;
        int second_number;
        int largest=-1;
        int second_largest=-1;
        boolean second_number_derived=false;
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)>='0' && s.charAt(i)<='9'){
                if(!first_number_derived){
                    first_number_derived=true;
                    first_number=s.charAt(i)-'0';
                    continue;
                }
                if(!second_number_derived){
                    int temp=s.charAt(i)-'0';
                    if(temp==first_number){
                        continue;
                    }
                    else{
                        second_number=temp;
                        second_number_derived=true;
                        if(first_number>second_number){
                            largest=first_number;
                            second_largest=second_number;
                        }
                        else{
                            second_largest=first_number;
                            largest=second_number;
                        }
                        continue;
                    }
                }
                int temper=s.charAt(i)-'0';
                if(temper>largest){
                    second_largest=largest;
                    largest=temper;
                }
                else if(temper>second_largest && temper<largest){
                    second_largest=temper;
                }
                else{
                    continue;
                }
            }
        }
        return second_largest;
    }
}
