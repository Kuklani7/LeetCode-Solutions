class Solution {
    public double findMaxAverage(int[] nums, int k) {
        int left=0;
        int right= k-1;
        float first_sum=0;
        for(int i=0; i<k; i++){
            first_sum+=nums[i];
        }
        float max_avg=first_sum/k;
        while(right+1!=nums.length){
            first_sum-=nums[left];
            left++;
            right++;
            first_sum+=nums[right];
            if((first_sum/k)> max_avg){
                max_avg= first_sum/k;
            }
        }
        return max_avg;
    }
}
