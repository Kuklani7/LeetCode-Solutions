class Solution {
    public List<Integer> findDuplicates(int[] nums) {
        List<Integer> ret_val= new ArrayList<>();
        for(int num: nums){
            int idx=Math.abs(num)-1;
            if(nums[idx]<0){
                ret_val.add(Math.abs(num));
            }
            else{
                nums[idx]*=-1;
            }
        }
        return ret_val;
    }
}
