class Solution {
    public boolean judgeSquareSum(int c) {
        if(c==0 || c==1){
            return true;
        }
        int left=0;
        int right=ret_lower(c);
        while(left<=right){
            if(right*right==c-left*left){
                return true;
            }
            else if(right*right<c-left*left){
                left++;
            }
            else{
                right--;
            }
        }
        return false;
    }
    private static int ret_lower(int check_for){
        int left=1;
        int right=check_for/2;
        while(left<=right){
            int mid=left+(right-left)/2;
            if(mid==check_for/mid){
                return mid;
            }
            else if(mid<=check_for/mid){
                left=mid+1;
            }
            else{
                right=mid-1;
            }
        }
        return right;
    }
}
