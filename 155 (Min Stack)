class MinStack {
    Stack<Integer> minStack;
    Stack<Integer> mainStack;

    public MinStack() {
        minStack=new Stack<>();
        mainStack=new Stack<>();
    }
    
    public void push(int val) {
        if(minStack.isEmpty()){
            minStack.push(val);
        }
        else{
            int help=minStack.peek();
            if(val<help){
                minStack.push(val);
            }
            else{
                minStack.push(help);
            }
        }
        mainStack.push(val);    
    }
    
    public void pop() {
       mainStack.pop();
       minStack.pop(); 
    }
    
    public int top() {
        return mainStack.peek();
    }
    public int getMin() {
        return minStack.peek();
    }
}
