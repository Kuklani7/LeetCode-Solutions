class Solution {
    public int balancedStringSplit(String s) {
        int counter=0;
        int r_count=0;
        int l_count=0;
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)=='R'){
                r_count++;
            }
            else{
                l_count++;
            }
            if(r_count!=0 && (r_count==l_count)){
                counter++;
                l_count=0;
                r_count=0;
            }
        }
        return counter;
    }
}
