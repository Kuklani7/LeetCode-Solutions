class Solution {
    public List<List<Integer>> shiftGrid(int[][] grid, int k) {
        List<List<Integer>> ret_value= new ArrayList<>();
        int m=grid.length;
        int n=grid[0].length;
        if(k==0){
            List<List<Integer>> ret_val= new ArrayList<>();
                for(int i=0; i<m; i++){
                    List<Integer> addant= new ArrayList<>();
                    for(int j=0; j<n ;j++){
                        addant.add(grid[i][j]);
                    }
                    ret_val.add(addant);
                }
                return ret_val;
        }
        
        while(k!=0){
            int [][] temp= new int [m][n];
            for(int i=0;i<grid.length; i++){
                for(int j=0; j<grid[0].length; j++){
                    int insert_i;
                    int insert_j;
                    if(j==n-1){
                        insert_i=(i+1)%m;
                        insert_j=0;
                    }
                    else{
                        insert_j=(j+1)%n;
                        insert_i=i;
                    }
                    temp[insert_i][insert_j]=grid[i][j];
                }
            }
            grid=temp;
            if(k==1){
                List<List<Integer>> ret_val= new ArrayList<>();
                for(int i=0; i<m; i++){
                    List<Integer> addant= new ArrayList<>();
                    for(int j=0; j<n ;j++){
                        addant.add(grid[i][j]);
                    }
                    ret_val.add(addant);
                }
                return ret_val;
            }
            k--;
        }
        return ret_value;
    }
}
