class Solution {
    public int majorityElement(int[] nums) {
        HashMap<Integer, Integer> freq_mapper=new HashMap<>();
        for(int i=0;i<nums.length;i++){
            if(!(freq_mapper.containsKey(nums[i]))){
                freq_mapper.put(nums[i],1);
            }
            else{
                int old=freq_mapper.get(nums[i]);
                freq_mapper.replace(nums[i],old+1);
            }
        }
        for(int x:freq_mapper.keySet()){
            if(freq_mapper.get(x)>(nums.length/2)){
                return x;
            }
        }
        return 0;
    }
}
