class Solution {
    public boolean isAnagram(String s, String t) {
        HashMap<Character, Integer> tracker=new HashMap<>();
        for(int i=0;i<t.length();i++){
            if(!tracker.containsKey(t.charAt(i))){
                tracker.put(t.charAt(i),1);
            }
            else{
                int old=tracker.get(t.charAt(i));
                tracker.put(t.charAt(i),old+1);
            }
        }
        for(int i=0;i<s.length();i++){
            if(tracker.containsKey(s.charAt(i))){
                int old=tracker.get(s.charAt(i));
                if(old==1){
                    tracker.remove(s.charAt(i));
                }
                else{
                    tracker.put(s.charAt(i),old-1);
                }
            }
            else{
                return false;
            }
        }
        if(tracker.isEmpty()){
            return true;
        }
        else{
            return false;
        }
    }
}
