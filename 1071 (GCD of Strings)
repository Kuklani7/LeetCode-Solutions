class Solution {
    public String gcdOfStrings(String str1, String str2) {
        StringBuilder sb= new StringBuilder();
        if((str1+str2).equals(str2+str1)){
            int receive=gcder(str1.length(), str2.length());
            for(int i=0;i<receive;i++){
                sb.append(str1.charAt(i));
            }
            return sb.toString();
        }
        else{
            return sb.toString();
        }
    }
    private static int gcder(int num1, int num2){
        while(num2!=0){
            int temp=num2;
            num2=num1%num2;
            num1=temp;
        }
        return num1;
    }
}
