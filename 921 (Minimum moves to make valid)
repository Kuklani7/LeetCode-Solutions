class Solution {
    public int minAddToMakeValid(String s) {
        Stack<Character> keeper= new Stack<>();
        for(int i=0;i<s.length();i++){
            if(keeper.isEmpty()){
                keeper.push(s.charAt(i));
                continue;
            }
            char curr_top =keeper.peek();
            if((int) curr_top==40 && (int) s.charAt(i)==41){
                keeper.pop();
                continue;
            }
            else{
                keeper.push(s.charAt(i));
            }
        }
        return keeper.size();
    }
}
