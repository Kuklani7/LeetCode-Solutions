class Solution {
    public boolean isValid(String s) {
        Stack<Integer> hecker= new Stack<>();
        if(((int)s.charAt(0))==40 || ((int)s.charAt(0))==91 || ((int)s.charAt(0))==123){
            hecker.push((int) s.charAt(0));
        }
        else{
            return false;
        }
        int i=1;
        while(!(i==s.length())){
            if(((int)s.charAt(i))==40 || ((int)s.charAt(i))==91 || ((int)s.charAt(i))==123){
                hecker.push(((int)s.charAt(i)));
                i++;
                continue;
            }
            else{
                if(hecker.isEmpty()){
                    return false;
                }
                int curr_top=hecker.peek();
                if(curr_top==40){
                    if(((int)s.charAt(i))!=41){
                        return false;
                    }
                    else{
                        hecker.pop();
                    }
                }
                if(curr_top==91 || curr_top==123){
                    if(((int)s.charAt(i))!=curr_top+2){
                        return false;
                    }
                    else{
                        hecker.pop();
                    }
                }
            }
            i++;
        }
        if(!hecker.isEmpty()){
            return false;
        }
        else{
            return true;
        }
    }
}
