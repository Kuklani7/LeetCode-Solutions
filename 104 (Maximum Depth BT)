class Solution {
    public int maxDepth(TreeNode root) {
        if(root==null){
            return 0;
        }
        int maxer=1;
        HashMap<TreeNode, Integer> mapper=new HashMap<>();
        Queue<TreeNode> queue= new LinkedList<>();
        queue.offer(root);
        mapper.put(root,1);
        while(!queue.isEmpty()){
            TreeNode curr=queue.poll();
            if(curr.left!=null){
                queue.offer(curr.left);
                mapper.put(curr.left, mapper.get(curr)+1);
                if(mapper.get(curr)+1 > maxer){
                    maxer= mapper.get(curr)+1;
                }
            }
            if(curr.right!=null){
                queue.offer(curr.right);
                mapper.put(curr.right, mapper.get(curr)+1);
                if(mapper.get(curr)+1 > maxer){
                    maxer= mapper.get(curr)+1;
                }
            }
        }
        return maxer;
    }
}
