class Solution {
    public int findMin(int[] nums) {
        if(nums.length==1){
            return nums[0];
        }
        if(nums[nums.length-1]<nums[nums.length-2]){
            return nums[nums.length-1];
        }
        if(nums[0]<nums[nums.length-1]){
            return nums[0];
        }
        int left=1;
        int right=nums.length-2;
        while(left<=right){
            int mid=(left+right)/2;
            boolean left_sorted=nums[mid]>=nums[left];
            boolean right_sorted=nums[right]>=nums[mid];
            if(nums[mid-1]>nums[mid]){
                return nums[mid];
            }
            if(left_sorted && right_sorted){
                return nums[left];            
            }
            if(left_sorted){
                left=mid+1;
            }
            else{
                right=mid-1;
            }
        }
        return -1;
    }
}
