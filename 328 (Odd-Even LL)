class Solution {
    public ListNode oddEvenList(ListNode head) {
        if(head==null || head.next==null){
            return head;
        }
        ListNode mover=head;
        ListNode connect=mover.next;
        ListNode prev=null;
        while(mover!=null && mover.next!=null){
            ListNode saver=mover.next;
            mover.next=mover.next.next;
            prev=mover;
            mover=mover.next;
            if(mover!=null){
                saver.next=mover.next;
            }
        }
        if(mover==null){
            prev.next=connect;
        }
        else{
            mover.next=connect;
        }
        return head;
    }
}
